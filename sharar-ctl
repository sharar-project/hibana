#!/usr/bin/env python3
"""Operate Sharar on this machine: serve, record traces, train the drafter, promote.

Host-side and dependency-free (Python 3 standard library only); it drives the
launchers `run-sharar.sh` and `run-sharar-train.sh`, which run Sharar from this
checkout's Python environment (.venv, built by tools/setup-venv.sh) as user
systemd services.

  sharar-ctl launch claude|opencode|aider [ARGS...]   # a coding agent set up for the serving target
  sharar-ctl launch show      # base URLs, model name and context for any other tool
  sharar-ctl setup            # build or update the Python environment (serve does this itself when needed)
  sharar-ctl serve [27b | flashnext] [--no-traces] [--pinned | --draft DIR] [--fp8] [--exact | --balanced | --fast | --throughput]
  sharar-ctl serve [27b | flashnext] --tp 2 [--exact | --balanced | --fast | --throughput]   # on two Sparks: ./sharar-tp
  sharar-ctl stop [27b | flashnext]
  sharar-ctl status [27b | flashnext]
  sharar-ctl train            # stop serving, train until `train stop`
  sharar-ctl train stop       # final held-out evaluation, promote, serve again
  sharar-ctl train status
  sharar-ctl draft list | use RUN | pinned
  sharar-ctl traces
  sharar-ctl logs [27b | flashnext] [--train] [-n LINES]
  sharar-ctl chat [27b | flashnext] [--think] [--max-tokens N] [--temperature T] [--no-trace]

The target defaults to SHARAR_TARGET, else the 27B; stop, status, logs and chat pick the target that is
serving when none is named, and the pair on two Sparks when ./sharar-tp serves one. Settings come from the environment, config/gb10.env (optional), the target's
config/targets/<target>.env and defaults, resolved by tools/launcher-config.sh as the launcher resolves them.
A missing model or draft is downloaded on the first serve.

Tracing is on by default under this command (traces land in
$SHARAR_RESULTS/traces): the loop exists to train on your own traffic.
Traces are your prompts; they stay on this machine.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
TP_PID = ROOT / "results" / "tp" / "pid"  # ./sharar-tp's serving pair


TARGETS = ("27b", "flashnext", "qwen38", "flash-next")  # user-facing names; tools/launcher-config.sh maps them


def load_env(target: str | None = None) -> dict:
    """The environment, then what tools/launcher-config.sh resolves for `target` (default: SHARAR_TARGET, else
    the 27B): the user's config file, the target's settings, defaults. The environment outranks the rest."""
    env = dict(os.environ)
    out = subprocess.run(["bash", str(ROOT / "tools" / "launcher-config.sh"), "print", *([target] if target else [])],
                         env=env, capture_output=True, text=True)
    if out.returncode:
        sys.exit(out.stderr.strip() or "tools/launcher-config.sh failed")
    resolved = dict(line.partition("=")[::2] for line in out.stdout.splitlines() if "=" in line)
    for key, value in resolved.items():
        env.setdefault(key, value)
    env["SHARAR_TARGET"] = resolved["SHARAR_TARGET"]
    env.setdefault("SHARAR_TRACES", str(Path(env["SHARAR_RESULTS"]) / "traces"))
    env.setdefault("SHARAR_DRAFT_RUNS", str(Path(env["SHARAR_RESULTS"]) / "draft-runs"))
    return env


def venv_python(env: dict) -> str:
    return str(Path(env.get("SHARAR_VENV") or ROOT / ".venv") / "bin" / "python")


def log_file(env: dict, service: str) -> Path:
    return Path(env["SHARAR_RESULTS"]) / "logs" / f"{service}.log"


def run(command: list[str], env: dict, dry: bool) -> int:
    if dry:
        print("+ " + " ".join(command))
        return 0
    return subprocess.call(command, env=env, cwd=ROOT)


def service_running(name: str) -> bool:
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", name]).returncode == 0


def server_info(port: str) -> dict | None:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/get_server_info", timeout=3) as r:
            return json.loads(r.read())
    except Exception:  # noqa: BLE001 - not serving
        return None


def post_json(port: str, route: str, payload: dict, timeout: float = 120) -> dict:
    request = urllib.request.Request(f"http://127.0.0.1:{port}{route}", data=json.dumps(payload).encode(),
                                     headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        try:
            detail = json.loads(detail)["error"]["message"]
        except Exception:  # noqa: BLE001 - not the engine's error shape
            pass
        sys.exit(f"{route} failed: {detail}")


def reload_served_draft(env: dict, run: str | None, dry: bool) -> bool:
    """Swap the draft in the running server: a run name, or None for the pinned draft.
    Returns False when nothing is serving."""
    port = env["SHARAR_PORT"]
    target = str(Path(env["SHARAR_DRAFT_RUNS"]) / run / "best") if run else "pinned"
    if dry:
        print(f"+ POST http://127.0.0.1:{port}/reload_draft {{\"draft\": \"{target}\"}}")
        return True
    if server_info(port) is None:
        return False
    reply = post_json(port, "/reload_draft", {"draft": target})
    print(f"serving now uses {reply.get('draft')} ({reply.get('seconds')}s)")
    return True


def current_draft(env: dict) -> Path | None:
    link = Path(env["SHARAR_DRAFT_RUNS"]) / "current"
    if not link.is_symlink():
        return None
    target = link.resolve()
    return target if (target / "config.json").is_file() else None


def tp_serving() -> bool:
    """Whether ./sharar-tp is serving the 27B on two Sparks."""
    if not TP_PID.is_file():
        return False
    try:
        os.kill(int(TP_PID.read_text()), 0)
    except ProcessLookupError:
        return False
    return True


def cmd_serve(args, env, dry) -> int:
    if args.tp == 2:
        if env["SHARAR_TARGET"] not in ("qwen38", "flashnext") or args.draft or args.pinned:
            sys.exit("--tp 2 serves the 27B or Flash-Next with its pinned draft (docs/tensor-parallel.md)")
        return run([str(ROOT / "sharar-tp"), "serve", *([f"--{args.profile}"] if args.profile else [])], env, dry)
    env = dict(env)
    if args.no_traces:
        env.pop("SHARAR_TRACES", None)
    if args.pinned:
        env["SHARAR_DRAFT"] = "pinned"
    elif args.draft:
        env["SHARAR_DRAFT"] = str(Path(args.draft).resolve())
    if args.fp8:
        env["SHARAR_DRAFT_PRECISION"] = "fp8"
    if args.profile:
        env["SHARAR_PROFILE"] = args.profile
    rc = run([str(ROOT / "run-sharar.sh")], env, dry)
    return rc if rc or dry else follow_startup(env)


MILESTONES = ("loading", "  weights loaded", "  w3: ", "  captured verify graph for batch", "  warmup done", "serving on")


def follow_startup(env: dict) -> int:
    """Print the server's startup milestones from its log until it serves, fails or exits."""
    service, log = env["SHARAR_SERVICE"], log_file(env, env["SHARAR_SERVICE"])
    shown = 0
    while True:
        lines = log.read_text(errors="replace").splitlines() if log.is_file() else []
        for line in lines[shown:]:
            if line.startswith(MILESTONES):
                print("  " + line.strip())
            if line.startswith("serving on"):
                print(f"ready: http://127.0.0.1:{env['SHARAR_PORT']} (sharar-ctl chat, sharar-ctl launch claude, sharar-ctl stop)")
                return 0
        shown = len(lines)
        if not service_running(service) or any(line.startswith("Traceback") for line in lines):
            print("\n".join(lines[-30:]))
            print(f"{service} failed to start; full log: {log}")
            return 1
        time.sleep(2)


HARNESSES = ("claude", "opencode", "aider", "codex", "show")
ALIASES = {"qwen38": ("qwen3.8-27b", "Qwen3.8-27B"), "flashnext": ("qwen3.8-flash-next", "Qwen3.8-Flash-Next")}
OUTPUT_TOKENS = 32768  # reply budget the harness configs declare (thinking included); the context is the server's


def write_config(path: Path, data: dict, dry: bool) -> None:
    if dry:
        print(f"+ write {path}: {json.dumps(data)}")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def cmd_launch(args, env, dry) -> int:
    """Start a coding agent against the serving target with its own config (the user's own settings are not touched)."""
    if args.harness == "codex":
        sys.exit("Codex needs the OpenAI Responses API (/v1/responses), which Sharar does not serve")
    url = (os.environ.get("SHARAR_URL") or f"http://127.0.0.1:{env['SHARAR_PORT']}").rstrip("/")
    try:
        with urllib.request.urlopen(f"{url}/get_server_info", timeout=3) as r:
            info = json.loads(r.read())
    except Exception:  # noqa: BLE001 - not serving
        if not dry:
            sys.exit(f"nothing is serving at {url}: ./sharar-ctl serve 27b (or flashnext) first")
        info = {}
    context = int(info.get("context_length", 262144))
    alias, display = ALIASES[env["SHARAR_TARGET"]]
    conf = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "sharar"
    henv = dict(os.environ)
    if args.harness == "show":
        print(f"Sharar is serving {display} at {url} (context {context} tokens)")
        print(f"  OpenAI-compatible tools:  base URL {url}/v1, model {alias}, any API key")
        print(f"  Anthropic Messages tools: base URL {url}, any model name and API key (Claude Code: sharar-ctl launch claude)")
        print("  Cline, Continue, Zed, Pi and others: an OpenAI-compatible provider with those values, context window "
              f"{context}, max output {OUTPUT_TOKENS}")
        return 0
    if args.harness == "claude":
        # Claude Code only accepts model ids containing "claude"; its own config directory keeps the user's
        # Anthropic login, settings and history untouched (the first launch asks the onboarding questions).
        model = os.environ.get("SHARAR_CLAUDE_MODEL", "claude-sharar-qwen3.8")
        for k in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDECODE"):
            henv.pop(k, None)
        henv.update(ANTHROPIC_BASE_URL=url, ANTHROPIC_AUTH_TOKEN="sharar", ANTHROPIC_MODEL=model,
                    ANTHROPIC_DEFAULT_SONNET_MODEL=model, ANTHROPIC_DEFAULT_OPUS_MODEL=model, ANTHROPIC_DEFAULT_HAIKU_MODEL=model,
                    CLAUDE_CODE_MAX_CONTEXT_TOKENS=str(context), CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1",
                    # the model name is not in Claude Code's catalog: without this it assumes a 200K window
                    CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT="1",
                    CLAUDE_CONFIG_DIR=os.environ.get("SHARAR_CLAUDE_CONFIG", str(Path.home() / ".claude-sharar")))
        command = ["claude", *args.args]
    elif args.harness == "opencode":
        # OPENCODE_CONFIG is merged over the user's global config: a `sharar` provider and the default model.
        path = conf / "opencode.json"
        write_config(path, {"$schema": "https://opencode.ai/config.json", "model": f"sharar/{alias}",
                            "provider": {"sharar": {"npm": "@ai-sdk/openai-compatible", "name": "Sharar",
                                                    "options": {"baseURL": f"{url}/v1", "apiKey": "sharar"},
                                                    "models": {alias: {"name": f"{display} (Sharar)",
                                                                       "limit": {"context": context, "output": OUTPUT_TOKENS}}}}}}, dry)
        henv["OPENCODE_CONFIG"] = str(path)
        command = ["opencode", *args.args]
    else:  # aider: an OpenAI-compatible endpoint plus the model's context in a metadata file
        path = conf / "aider.model.metadata.json"
        write_config(path, {f"openai/{alias}": {"max_tokens": OUTPUT_TOKENS, "max_input_tokens": context,
                                                 "max_output_tokens": OUTPUT_TOKENS, "input_cost_per_token": 0,
                                                 "output_cost_per_token": 0, "litellm_provider": "openai", "mode": "chat"}}, dry)
        henv.update(OPENAI_API_BASE=f"{url}/v1", OPENAI_API_KEY="sharar")
        command = ["aider", "--model", f"openai/{alias}", "--model-metadata-file", str(path), *args.args]
    if dry:
        print("+ " + " ".join(command))
        return 0
    if shutil.which(command[0]) is None:
        sys.exit(f"{command[0]} is not installed or not on PATH")
    os.execvpe(command[0], command, henv)  # in the caller's directory, replacing this process


def cmd_setup(args, env, dry) -> int:
    return run(["bash", str(ROOT / "tools" / "setup-venv.sh")], env, dry)


def cmd_stop(args, env, dry) -> int:
    if tp_serving():
        return run([str(ROOT / "sharar-tp"), "stop"], env, dry)
    return run([str(ROOT / "run-sharar.sh"), "--stop"], env, dry)


def cmd_status(args, env, dry) -> int:
    if tp_serving():
        return run([str(ROOT / "sharar-tp"), "status"], env, dry)
    port = env["SHARAR_PORT"]
    serving = service_running(env["SHARAR_SERVICE"])
    info = server_info(port) if serving else None
    if info:
        spec = info.get("speculative") or {}
        traces = info.get("scheduler", {}).get("traces") or info.get("traces")
        print(f"serving: up on port {port}, draft {spec.get('draft')}, precision {spec.get('draft_precision')}")
        stats = info.get("spec_stats") or {}
        if stats.get("rounds"):
            print(f"  tokens per round so far {stats['tokens_per_round']:.3f} over {stats['rounds']} rounds")
        if traces:
            print(f"  traces: {traces['records']} recorded, {traces['bytes'] / 2**20:.0f} MiB, {traces['dropped']} dropped")
        else:
            print("  traces: off")
    else:
        print("serving: " + ("starting" if serving else "down"))
    training = service_running(env.get("SHARAR_TRAIN_SERVICE", "sharar-train"))
    print("training: " + ("running (sharar-ctl train stop to finish)" if training else "not running"))
    draft = current_draft(env)
    if draft:
        manifest = draft / "manifest.json"
        note = ""
        if manifest.is_file():
            m = json.loads(manifest.read_text())
            note = f" (step {m.get('step')}, held-out tokens/round {m.get('eval', {}).get('tokens_per_round', 0):.3f})"
        print(f"current draft: {draft}{note}")
    else:
        print("current draft: pinned publisher draft (nothing promoted yet)")
    traces_dir = Path(env["SHARAR_TRACES"])
    files = list(traces_dir.glob("traces-*.jsonl")) if traces_dir.is_dir() else []
    size = sum(f.stat().st_size for f in traces_dir.rglob("*") if f.is_file()) if traces_dir.is_dir() else 0
    print(f"trace directory: {traces_dir} ({len(files)} files, {size / 2**20:.0f} MiB)")
    return 0


def cmd_train(args, env, dry) -> int:
    script = str(ROOT / "run-sharar-train.sh")
    if args.action == "start":
        return run([script, "start"], env, dry)
    if args.action == "stop":
        return run([script, "stop"] + (["--no-serve"] if args.no_serve else []), env, dry)
    return run([script, "status"], env, dry)


def cmd_draft(args, env, dry) -> int:
    runs = Path(env["SHARAR_DRAFT_RUNS"])
    link = runs / "current"
    if args.action == "list":
        current = current_draft(env)
        for run_dir in sorted(runs.glob("run-*")):
            manifest = run_dir / "manifest.json"
            best = run_dir / "best"
            if not manifest.is_file():
                continue
            m = json.loads(manifest.read_text())
            mark = " *" if current and best.resolve() == current else ""
            base = m.get("base_eval", {}).get("tokens_per_round")
            b = m.get("best", {})
            print(f"{run_dir.name}: base {base:.3f} -> best {b.get('tokens_per_round', 0):.3f} at step {b.get('step')}{mark}")
        print("current: " + (str(current) if current else "pinned publisher draft"))
        return 0
    if args.action == "use":
        target = runs / args.run / "best"
        if not (target / "config.json").is_file():
            sys.exit(f"{target} is not a promoted checkpoint")
        if dry:
            print(f"+ ln -sfn {os.path.relpath(target, runs)} {link}")
            return 0
        tmp = runs / ".current.tmp"
        if tmp.is_symlink() or tmp.exists():
            tmp.unlink()
        tmp.symlink_to(os.path.relpath(target, runs))
        tmp.replace(link)
        print(f"current -> {target}")
        if not reload_served_draft(env, args.run, dry):
            print("serving is down; it follows current at the next sharar-ctl serve")
        return 0
    if args.action == "pinned":
        if link.is_symlink() and not dry:
            link.unlink()
        print("current draft removed")
        if not reload_served_draft(env, None, dry):
            print("serving is down; it uses the pinned publisher draft at the next sharar-ctl serve")
        return 0
    if args.action == "reload":
        current = current_draft(env)
        run = current.parent.name if current and current.parent.parent == runs.resolve() else None
        if current and run is None:
            sys.exit(f"current draft {current} is outside {runs}; serve it with sharar-ctl serve --draft")
        if not reload_served_draft(env, run, dry):
            sys.exit("serving is not up (sharar-ctl serve)")
        return 0
    return 2


def cmd_traces(args, env, dry) -> int:
    env = {**env, "PYTHONPATH": str(ROOT)}
    return run([venv_python(env), "-m", "sharar", "traces", "--dir", env["SHARAR_TRACES"]], env, dry)


def cmd_chat(args, env, dry) -> int:
    """Streaming multi-turn chat against the running server; /reset, /think, /quit."""
    import time
    url = f"http://127.0.0.1:{env['SHARAR_PORT']}/v1/chat/completions"
    if server_info(env["SHARAR_PORT"]) is None:
        sys.exit("serving is not up (sharar-ctl serve)")
    messages = []
    if args.system:
        messages.append({"role": "system", "content": args.system})
    think = args.think
    max_tokens = args.max_tokens
    print(f"chatting with Sharar on {url} (thinking {'on' if think else 'off'}, budget {max_tokens} tokens; /reset, /think, /max N, /quit)", flush=True)
    while True:
        try:
            line = input("\nyou> ")
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        text = line.strip()
        if not text:
            continue
        if text in ("/quit", "/exit"):
            return 0
        if text == "/reset":
            messages = messages[:1] if messages and messages[0]["role"] == "system" else []
            print("(history cleared)")
            continue
        if text.startswith("/think"):
            think = not think if text == "/think" else text.split()[-1] == "on"
            print(f"(thinking {'on' if think else 'off'})")
            continue
        if text.startswith("/max"):
            try:
                max_tokens = int(text.split()[1])
                print(f"(reply budget {max_tokens} tokens)")
            except (IndexError, ValueError):
                print("usage: /max N")
            continue
        messages.append({"role": "user", "content": text})
        body = {"model": "sharar", "messages": messages, "stream": True, "max_tokens": max_tokens,
                "temperature": args.temperature, "chat_template_kwargs": {"enable_thinking": think},
                "stream_options": {"include_usage": True}}
        if args.no_trace:
            body["trace"] = False
        request = urllib.request.Request(url, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
        started = time.perf_counter()
        first = None
        reply, reasoning, usage, finish = [], [], None, None
        try:
            with urllib.request.urlopen(request, timeout=args.timeout) as response:
                print("sharar> ", end="", flush=True)
                for raw in response:
                    raw = raw.decode().strip()
                    if not raw.startswith("data:"):
                        continue
                    data = raw[5:].strip()
                    if data == "[DONE]":
                        break
                    event = json.loads(data)
                    if event.get("usage"):
                        usage = event["usage"]
                    for choice in event.get("choices") or []:
                        finish = choice.get("finish_reason") or finish
                        delta = choice.get("delta") or {}
                        if delta.get("reasoning_content"):
                            if first is None:
                                first = time.perf_counter()
                            reasoning.append(delta["reasoning_content"])
                            if args.show_thinking:
                                print(delta["reasoning_content"], end="", flush=True)
                        if delta.get("content"):
                            if first is None:
                                first = time.perf_counter()
                            reply.append(delta["content"])
                            print(delta["content"], end="", flush=True)
        except KeyboardInterrupt:
            print("\n(interrupted)")
            messages.pop()
            continue
        except urllib.error.URLError as exc:
            print(f"\nrequest failed: {exc}")
            messages.pop()
            continue
        elapsed = time.perf_counter() - started
        answer = "".join(reply)
        messages.append({"role": "assistant", "content": answer})
        completion = (usage or {}).get("completion_tokens")
        ttft = f"{first - started:.2f}s to first token, " if first else ""
        rate = f"{completion / max(elapsed - (first - started if first else 0), 1e-6):.1f} tok/s" if completion else ""
        print(f"\n[{completion or '?'} tokens, {ttft}{rate}{', thinking hidden' if reasoning and not args.show_thinking else ''}]")
        if finish == "length":
            what = "while still thinking; no answer was produced" if reasoning and not answer else "before the reply finished"
            print(f"(stopped at the {max_tokens}-token budget {what}: /max N raises it, /think off skips thinking)")


def cmd_logs(args, env, dry) -> int:
    if tp_serving() and not args.train:
        return run([str(ROOT / "sharar-tp"), "logs", "-n", str(args.lines), *(["-f"] if args.follow else [])], env, dry)
    name = env.get("SHARAR_TRAIN_SERVICE", "sharar-train") if args.train else env["SHARAR_SERVICE"]
    return run(["tail", "-n", str(args.lines)] + (["-F"] if args.follow else []) + [str(log_file(env, name))], env, dry)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="sharar-ctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--dry-run", action="store_true", help="print the commands instead of running them")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("serve", help="start serving a target (downloads what is missing; records traces unless --no-traces)")
    p.add_argument("target", nargs="?", choices=TARGETS, help="27b (Qwen3.8-27B) or flashnext (Qwen3.8-Flash-Next)")
    p.add_argument("--no-traces", action="store_true")
    p.add_argument("--pinned", action="store_true", help="serve the publisher draft even if one was promoted")
    p.add_argument("--draft", default=None, help="serve this checkpoint directory")
    p.add_argument("--fp8", action="store_true", help="FP8 draft precision (the optimized measured profile)")
    p.add_argument("--tp", type=int, choices=(1, 2), default=1, help="Sparks to serve on: 2 serves the target tensor-parallel "
                   "from the uv venv on each (./sharar-tp; docs/tensor-parallel.md)")
    g = p.add_mutually_exclusive_group()
    for name, text in (("exact", "the target's own distribution: exact acceptance, no lossy weight copies"),
                       ("balanced", "relaxed greedy acceptance top-2/1.0, the 27B's calibrated 3-bit copies"),
                       ("fast", "the default: every measured speed option, lossy ones included (docs/operations.md#serving-profiles)"),
                       ("throughput", "fast with more requests at once (27B 16, Flash-Next 128) for evals and many agents")):
        g.add_argument(f"--{name}", dest="profile", action="store_const", const=name, help=text)
    p = sub.add_parser("launch", help="start a coding agent (claude, opencode, aider) set up for the serving target; `show` prints the settings for any other tool")
    p.add_argument("harness", choices=HARNESSES)
    p.add_argument("--target", choices=TARGETS, default=None, help="before the agent name; default: the target that is serving")
    p.add_argument("args", nargs=argparse.REMAINDER, help="passed to the agent unchanged")
    sub.add_parser("setup", help="build or update the Python environment (tools/setup-venv.sh)")
    sub.add_parser("stop", help="stop serving").add_argument("target", nargs="?", choices=TARGETS)
    sub.add_parser("status", help="serving, training, current draft and trace directory").add_argument("target", nargs="?", choices=TARGETS)
    p = sub.add_parser("train", help="stop serving and train the drafter on the recorded traces")
    p.add_argument("action", nargs="?", choices=("start", "stop", "status"), default="start")
    p.add_argument("--no-serve", action="store_true", help="with stop: do not relaunch serving")
    p = sub.add_parser("draft", help="promoted checkpoints; use/pinned/reload swap the running server's draft in place")
    p.add_argument("action", choices=("list", "use", "pinned", "reload"))
    p.add_argument("run", nargs="?", help="with use: a run directory name from `draft list`")
    sub.add_parser("traces", help="summarize the recorded traces")
    p = sub.add_parser("chat", help="chat with the running server in the terminal")
    p.add_argument("target", nargs="?", choices=TARGETS)
    p.add_argument("--think", action="store_true", help="enable the model's thinking mode")
    p.add_argument("--show-thinking", action="store_true", help="print thinking content as it streams")
    p.add_argument("--system", default=None)
    p.add_argument("--max-tokens", type=int, default=8192, help="reply budget, thinking included (context is 32K)")
    p.add_argument("--temperature", type=float, default=0.0, help="0 = greedy")
    p.add_argument("--no-trace", action="store_true", help="do not record this conversation")
    p.add_argument("--timeout", type=float, default=600)
    p = sub.add_parser("logs", help="the server's (or trainer's) log")
    p.add_argument("target", nargs="?", choices=TARGETS)
    p.add_argument("--train", action="store_true")
    p.add_argument("-n", "--lines", type=int, default=50)
    p.add_argument("-f", "--follow", action="store_true")
    args = parser.parse_args(argv)
    target = getattr(args, "target", None)
    env = load_env(target)
    if target is None and args.command in ("stop", "status", "logs", "chat", "launch") and not service_running(env["SHARAR_SERVICE"]):
        # nothing named and the default target is not serving: follow the one that is
        other = load_env("qwen38" if env["SHARAR_TARGET"] == "flashnext" else "flashnext")
        if service_running(other["SHARAR_SERVICE"]):
            env = other
    handler = {"serve": cmd_serve, "launch": cmd_launch, "setup": cmd_setup, "stop": cmd_stop, "status": cmd_status, "train": cmd_train,
               "draft": cmd_draft, "traces": cmd_traces, "logs": cmd_logs, "chat": cmd_chat}[args.command]
    return handler(args, env, args.dry_run)


if __name__ == "__main__":
    raise SystemExit(main())
