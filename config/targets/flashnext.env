# Qwen3.8-Flash-Next: what `sharar-ctl serve flashnext` serves. Settings only (no host paths); a value set in the
# environment or in config/gb10.env wins. Loaded by tools/launcher-config.sh.
SHARAR_CONTAINER=sharar-flashnext
SHARAR_PORT=30004
SHARAR_PROPOSER=mtp
SHARAR_SPEC=4
SHARAR_VERIFY_STATE=reconstruct
SHARAR_DRAFT_PRECISION=bf16
SHARAR_DRAFT=pinned
SHARAR_DRAFT_HEAD=w3
SHARAR_FLASHNEXT_TRUNK=fp8
