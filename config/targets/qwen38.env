# Qwen3.8-27B: what `sharar-ctl serve 27b` serves. Settings only (no host paths); a value set in the
# environment or in config/gb10.env wins. Loaded by tools/launcher-config.sh.
SHARAR_CONTAINER=sharar-qwen38
SHARAR_PORT=30001
SHARAR_PROPOSER=dflash2
SHARAR_SPEC=15
SHARAR_VERIFY_STATE=reconstruct
SHARAR_DRAFT_PRECISION=fp8
