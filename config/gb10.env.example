# Optional settings for `hibana serve` and the tools: copy this file to config/gb10.env (or
# ~/.config/hibana/hibana.env, or point HIBANA_CONFIG_FILE at it; the former SHARAR_* names are read too).
# Without it the defaults apply. Command-line flags and HIBANA_* environment variables win over this file; this file
# wins over each target's and profile's defaults (hibana/launch/settings.py). The real file is ignored by Git; do not put tokens or credentials here.

# Model cache (Hugging Face layout); missing pinned snapshots are downloaded here on first serve.
# Default: $HF_HOME, else ~/.cache/huggingface.
# HIBANA_HF_CACHE=/path/to/huggingface
# Flash-Next's cache (135 GB), if it lives elsewhere. Default: HIBANA_HF_CACHE.
# HIBANA_FLASHNEXT_CACHE=/path/to/huggingface-flash-next

# Results, traces, 3-bit checkpoints and logs. Default: ~/.local/share/hibana (~/.local/share/sharar while only that
# exists).
# HIBANA_RESULTS=/path/to/hibana-results

# Serving profile when no flag names one (exact, fast, throughput). Default: fast.
# HIBANA_PROFILE=fast
# Largest prompt plus output per request (default 262144, the model's native length).
# HIBANA_MAX_CONTEXT=262144
# Relaxed speculative acceptance for greedy requests that do not set accept_top_k/accept_margin: K:M = top-K within
# M logits; 'off' keeps every request exact. Default: the profile's (fast: 3:2.0; 2:1.0 for a DFlash2 draft).
# HIBANA_ACCEPT_DEFAULT=3:2.0
# Calibrated 3-bit decode copies: auto keeps $HIBANA_RESULTS/w3-checkpoints/<target>-current on the pinned published
# revision at every serve (docs/w3-calibration.md); a directory serves another calibration.
# HIBANA_W3_CHECKPOINT=auto

# Flash-Next QSA prefill: original, auto (optimized when eligible), or optimized (require support).
# Default: the profile's (fast and throughput: auto; exact: original).
# Optimized kernels cover SM121 TP1/TP2 sparse eager prefill through 32K; other modes retain original kernels.
# HIBANA_QSA_PREFILL_BACKEND=auto

# Request traces: each request's token IDs and speculative rounds (off by default; a directory here, or
# `hibana serve --traces` for $HIBANA_RESULTS/traces, turns them on). Traces are your prompts; they stay on this
# machine. The oldest files go above the cap.
# HIBANA_TRACES=/path/to/hibana-traces
# HIBANA_TRACES_MAX_MIB=32768

# The SSD tier keeps evicted prefixes on each Spark's NVMe, in $HIBANA_RESULTS/ssd/<target>, up to HIBANA_SSD_GIB. Default: on.
# HIBANA_SSD=0
# HIBANA_SSD_GIB=200

# The DFlash2 draft (the 27B's, or Flash-Next's with HIBANA_PROPOSER=dflash2): the publisher's (pinned, the default)
# or a DFlash2 checkpoint directory of the same architecture.
# HIBANA_DRAFT=/path/to/dflash2-checkpoint

# Two Sparks: the peer's address on the RoCE link (default: found automatically).
# HIBANA_TP_PEER=192.168.100.2
