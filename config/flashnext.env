# Launcher configuration for serving Qwen3.8-Flash-Next (SHARAR_CONFIG_FILE=config/flashnext.env ./run-sharar.sh).
SHARAR_HF_CACHE=/home/yke/data/huggingface-qwen38-nvfp4-dspark
