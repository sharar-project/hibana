#!/usr/bin/env bash
# A target tensor-parallel on two DGX Sparks (docs/tensor-parallel.md): rank 0 here with the HTTP API on
# 127.0.0.1:30001, rank 1 on the peer, each from its uv venv. `./sharar-ctl serve 27b|flashnext --tp 2` runs this,
# and `./sharar-ctl stop | status | logs | chat | launch` follow it as they follow the container.
#
#   ./sharar-tp serve [--exact | --balanced | --fast | --throughput] [sharar serve arguments...]   in the background
#   ./sharar-tp status | stop | logs [-f]
#   ./sharar-tp setup      the venv on both Sparks; model, draft and 3-bit checkpoint here, copied to the peer
#                          (the first serve of each target runs it)
#
# The target is SHARAR_TARGET (qwen38 or flashnext; default qwen38), served with its settings as the single-Spark
# launcher resolves them (config/targets/<target>.env through tools/launcher-config.sh; the environment wins); a
# failed rank ends the other and the pair restarts (up to 5 times in 10 minutes).
#   ./sharar-tp comm [--vllm] [--nccl-env vllm-batch-invariant]
#                          the RDMA one-shot all-reduce against NCCL between the two Sparks (profiling/tp_comm.py)
#   ./sharar-tp draft-head the vocabulary-parallel draft head against the whole-vocabulary one (profiling/tp_draft_head.py)
#
# Profiles are sharar-ctl's (tools/serving-profile.sh; fast by default); SHARAR_W3_DECODE=0 serves the native NVFP4/FP8
# weights instead of the 3-bit copies, and SHARAR_TP_ALLREDUCE=nccl runs every all-reduce on NCCL (no RDMA one-shot).
# The peer is SHARAR_TP_PEER (environment or config/gb10.env), else the first host
# at the other end of a RoCE link that answers ssh. SHARAR_TP_PREFIX is a command both ranks run under, e.g.
# "nsys profile -o /path/tp2_%h ..." (%h: each host's name).
set -euo pipefail
cd "$(dirname "$0")"
[[ -f config/gb10.env ]] && source config/gb10.env
source tools/serving-profile.sh
TARGET=${SHARAR_TARGET:-qwen38}
case "$TARGET" in 27b) TARGET=qwen38 ;; flash-next) TARGET=flashnext ;; esac
# The target's settings as the single-Spark launcher resolves them; a variable already set in the environment wins.
while IFS='=' read -r key value; do
  [[ $key == SHARAR_* && -z ${!key+set} ]] && export "$key=$value"
done < <(bash tools/launcher-config.sh print "$TARGET")
HF_CACHE=${SHARAR_HF_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}}
W3_ROOT=${SHARAR_RESULTS:-$HOME/.local/share/sharar}/w3-checkpoints
RUN=results/tp  # the serving pair's log and process group, and the peer setup was done for
URL=http://127.0.0.1:30001
PY=(tools/lxcfs-run.sh .venv/bin/python)

peer() {
  if [[ -n "${SHARAR_TP_PEER:-}" ]]; then echo "$SHARAR_TP_PEER"; return; fi
  local net ip
  for net in /sys/class/infiniband/*/device/net/*; do
    for ip in $(ip -4 neigh show dev "$(basename "$net")" | awk '!/FAILED/ {print $1}'); do
      ssh -o BatchMode=yes -o ConnectTimeout=3 "$ip" true 2>/dev/null && { echo "$ip"; return; }
    done
  done
  echo "no peer found: set SHARAR_TP_PEER to the other Spark's address on the RoCE link" >&2
  exit 1
}

link() {  # PEER and ADDR (where the ranks meet), and ENV: what both ranks run with
  PEER=$(peer)
  local route dev
  route=$(ip -o route get "$PEER")
  dev=$(sed -n 's/.* dev \([^ ]*\).*/\1/p' <<< "$route")
  ADDR=$(sed -n 's/.* src \([^ ]*\).*/\1/p' <<< "$route"):29500
  ENV=(SHARAR_HF_CACHE="$HF_CACHE" HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
       CUDA_HOME=/usr/local/cuda PATH="$PWD/.venv/bin:/usr/local/cuda/bin:$PATH" NCCL_SOCKET_IFNAME="$dev")  # the venv's ninja builds the RDMA extension
  local key
  for key in $(compgen -e SHARAR_); do  # the engine's settings (rank 0 broadcasts its own to the others)
    [[ $key == SHARAR_TP_PREFIX || $key == SHARAR_TP_PEER ]] || ENV+=("$key=${!key}")
  done
}

mirror() {  # the checkout, at the same path on the peer
  rsync -a --delete --exclude .venv --exclude __pycache__ --exclude '*.egg-info' --exclude results ./ "$PEER:$PWD/"
}

both_ranks() {  # MODULE ARGS...: rank 1 on the peer over ssh, rank 0 here, each from its venv, with --tp-rank appended
  local module=$1 prefix
  shift
  read -ra prefix <<< "${SHARAR_TP_PREFIX:-}"
  mirror
  # A terminal for rank 1 (-tt): it gets SIGHUP and exits when its ssh ends, which ends with this script.
  trap 'kill $(jobs -p) 2>/dev/null' EXIT
  ssh -tt "$PEER" "cd $PWD && env $(printf '%q ' "${ENV[@]}") tools/lxcfs-run.sh ${prefix[*]} .venv/bin/python -u -m $module $(printf '%q ' "$@") --tp-rank 1" \
    2>&1 < /dev/null | sed -u 's/\r$//; s/^/[rank 1] /' &
  env "${ENV[@]}" tools/lxcfs-run.sh "${prefix[@]}" .venv/bin/python -u -m "$module" "$@" --tp-rank 0 &
  local rank0=$! status
  # `stop` signals this script, which passes it to rank 0 alone: rank 0 drains its requests, and its stop ends rank 1.
  trap "STOPPING=1; kill -TERM $rank0" TERM
  while kill -0 "$rank0" 2>/dev/null; do wait "$rank0" || true; done
  wait "$rank0" && status=0 || status=$?
  kill $(jobs -p) 2>/dev/null || true  # rank 1's ssh, if it outlived rank 0
  wait 2>/dev/null || true
  return "$status"
}

serve_pair() {  # ARGS...: both ranks of `sharar`, started again when either fails (a rank that dies ends the other)
  local starts=() status now recent t
  while :; do
    both_ranks sharar "$@" && status=0 || status=$?
    [[ $status == 0 || ${STOPPING:-0} == 1 ]] && return "$status"
    now=$(date +%s)
    starts+=("$now")
    recent=0
    for t in "${starts[@]}"; do (( now - t < 600 )) && recent=$((recent + 1)); done
    if (( recent >= 5 )); then
      echo "the pair failed $recent times in 10 minutes (exit $status); not restarting"
      return "$status"
    fi
    echo "the pair exited (status $status); restarting in 5 s"
    sleep 5
  done
}

cmd_setup() {
  local model rev draft drev models=()
  PEER=$(peer)
  echo "setting up $TARGET on this Spark and $PEER"
  [[ -x .venv/bin/python ]] || tools/setup-venv.sh
  mirror
  ssh "$PEER" "mkdir -p .local/bin && test -x .local/bin/uv" || scp -q "$(command -v uv)" "$PEER:.local/bin/uv"
  ssh "$PEER" "cd $PWD && { test -x .venv/bin/python || PATH=\$HOME/.local/bin:\$PATH tools/setup-venv.sh; }"
  # The RDMA all-reduce is a torch extension built on first use: it needs the interpreter's C headers on both Sparks.
  local headers='import os, sysconfig; raise SystemExit(not os.path.exists(os.path.join(sysconfig.get_paths()["include"], "Python.h")))'
  if ! .venv/bin/python -c "$headers" || ! ssh "$PEER" "cd $PWD && .venv/bin/python -c '$headers'"; then
    echo "the RDMA all-reduce needs the Python headers on both Sparks: sudo apt install python3.12-dev (or SHARAR_TP_ALLREDUCE=nccl)" >&2
    exit 1
  fi
  read -r model rev <<< "$("${PY[@]}" -c "from sharar.target import get; t = get('$TARGET'); print(t.model_id, t.model_revision)" 2>/dev/null)"
  mkdir -p "$HF_CACHE/hub" "$W3_ROOT" "$RUN"
  .venv/bin/python tools/fetch-model.py "$model" "$rev" "$HF_CACHE/hub" "$HF_CACHE"
  models+=("$HF_CACHE/hub/models--${model//\//--}")
  if [[ ${SHARAR_PROPOSER:-} == dflash2 || ${SHARAR_PROPOSER:-} == dspark ]]; then  # a separate draft checkpoint
    read -r draft drev <<< "$("${PY[@]}" -c "from sharar.proposers.parallel import PINS; print(*PINS['$SHARAR_PROPOSER'])" 2>/dev/null)"
    .venv/bin/python tools/fetch-model.py "$draft" "$drev" "$HF_CACHE/hub" "$HF_CACHE"
    models+=("$HF_CACHE/hub/models--${draft//\//--}")
  fi
  "${PY[@]}" -m sharar.weights.w3_checkpoint fetch --target "$TARGET" --root "$W3_ROOT" 2>/dev/null ||
    echo "no calibrated 3-bit checkpoint could be fetched for $TARGET"
  echo "copying the model, draft and 3-bit checkpoint to $PEER"
  ssh "$PEER" mkdir -p "$HF_CACHE/hub" "$W3_ROOT"
  rsync -a "${models[@]}" "$PEER:$HF_CACHE/hub/"
  rsync -a "$W3_ROOT/" "$PEER:$W3_ROOT/"
  echo "$PEER" > "$RUN/setup-peer-$TARGET"
  echo "both Sparks are set up"
}

cmd_run() {  # both ranks in the foreground: what `serve` starts in the background
  local profile=fast w3=""
  case "${1:-}" in --exact|--balanced|--fast|--throughput) profile=${1#--}; shift ;; esac
  serving_profile "$profile" "$TARGET"
  local w3_decode=${SHARAR_W3_DECODE:-$P_W3}
  if [[ $w3_decode == 1 ]]; then
    w3=${SHARAR_W3_CHECKPOINT:-auto}
    [[ $w3 == auto ]] && w3=$W3_ROOT/$TARGET-current
    if [[ -e $w3 ]]; then w3=$(realpath "$w3")
    elif [[ $TARGET == flashnext ]]; then echo "no calibrated 3-bit trunk at $w3: serving the FP8 trunk"; w3=""; w3_decode=0
    fi
  fi
  export SHARAR_PROFILE="$profile" SHARAR_W3_DECODE="$w3_decode" SHARAR_W3_CHECKPOINT="$w3" SHARAR_DEVICE_ACCEPT="$P_DEVICE_ACCEPT"
  export SHARAR_TP_ALLREDUCE="${SHARAR_TP_ALLREDUCE:-rdma}"
  # The NVMe session store, as the single-Spark launcher keeps it (off disables): each rank stores its own heads of
  # every session on its own Spark, at the same path.
  local sessions=${SHARAR_SESSION_DIR:-${SHARAR_RESULTS:-$HOME/.local/share/sharar}/sessions-tp}
  if [[ $sessions == off ]]; then unset SHARAR_SESSION_DIR
  else
    mkdir -p "$sessions"; ssh "$(peer)" mkdir -p "$sessions"
    export SHARAR_SESSION_DIR=$sessions SHARAR_SESSION_GIB=${SHARAR_SESSION_GIB:-200} SHARAR_SESSION_MIN_TOKENS=${SHARAR_SESSION_MIN_TOKENS:-4096}
  fi
  link
  local args=(serve --tp 2 --tp-address "$ADDR" --target "$TARGET" --proposer "$SHARAR_PROPOSER" --spec "$SHARAR_SPEC"
              --verify-state "$SHARAR_VERIFY_STATE" --draft-precision "$SHARAR_DRAFT_PRECISION"
              --accept-default "$P_ACCEPT" --max-batch "$P_MAX_BATCH")
  [[ $P_ACCEPT_SAMPLED == 1 && $P_ACCEPT != off ]] &&
    args+=(--accept-default-sampled ${P_ACCEPT_SAMPLED_THRESHOLD:+--accept-default-sampled-threshold "$P_ACCEPT_SAMPLED_THRESHOLD"})
  [[ -n $P_SPEC_DEPTHS ]] && args+=(--spec-depths "$P_SPEC_DEPTHS")
  serve_pair "${args[@]}" "$@"
}

cmd_serve() {
  if [[ -f $RUN/pid ]] && kill -0 "$(cat "$RUN/pid")" 2>/dev/null; then echo "already serving on two Sparks (stop first)"; exit 1; fi
  if curl -sf "$URL/get_server_info" > /dev/null; then echo "something already serves $URL: stop it first (./sharar-ctl stop)"; exit 1; fi
  local peer
  peer=$(peer)
  [[ -f $RUN/setup-peer-$TARGET && $(cat "$RUN/setup-peer-$TARGET") == "$peer" ]] || cmd_setup
  mkdir -p "$RUN"
  setsid "$0" _run "$@" > "$RUN/serve.log" 2>&1 < /dev/null &
  echo $! > "$RUN/pid"
  echo "starting $TARGET on two Sparks (this Spark and $peer); a minute or a few"
  # Rank 0's milestones as they land; done at "serving on", a traceback from either rank, or an exit.
  local milestones='^(loading|  weights loaded|  w3: |  captured verify graph for batch|  warmup done|serving on)'
  local shown=0 lines
  while :; do
    lines=$(grep -E "$milestones" "$RUN/serve.log" || true)
    [[ -n $lines ]] && sed -n "$((shown + 1)),\$p" <<< "$lines" | sed 's/^ */  /'
    shown=$(grep -cE "$milestones" "$RUN/serve.log" || true)
    grep -q "^serving on" "$RUN/serve.log" && break
    if grep -q Traceback "$RUN/serve.log" || ! kill -0 "$(cat "$RUN/pid")" 2>/dev/null; then
      tail -n 30 "$RUN/serve.log"
      cmd_stop
      exit 1
    fi
    sleep 2
  done
  echo "ready: $URL (./sharar-ctl chat, ./sharar-ctl launch claude, ./sharar-ctl stop)"
}

cmd_stop() {
  [[ -f $RUN/pid ]] || { echo "not serving on two Sparks"; return; }
  local group
  group=$(cat "$RUN/pid")
  kill "$group" 2>/dev/null || true  # the launcher, which stops rank 0; rank 0's stop ends rank 1
  echo "stopping (rank 0 drains its requests first)..."
  while kill -0 -- -"$group" 2>/dev/null; do sleep 1; done
  rm "$RUN/pid"
  echo "stopped"
}

cmd_status() {
  local info
  info=$(curl -sf "$URL/get_server_info") || { echo "not serving"; return; }
  python3 -c '
import json, sys
d = json.load(sys.stdin)
s = d.get("spec_stats") or {}
model, tp, ctx, batch = d["model_path"], d["tp_size"], d["context_length"], d["max_running_requests"]
w3 = "on" if d.get("w3_target_identity") else "off"
print(f"serving {model} on {tp} Spark(s): context {ctx}, up to {batch} requests, 3-bit copies {w3}")
if s.get("rounds"):
    rounds, per, ms = s["rounds"], s["tokens_per_round"], s["round_ms"]
    print(f"  {rounds} speculative rounds so far: {per:.2f} tokens per round, {ms:.1f} ms each")' <<< "$info"
}

cmd_comm() {
  if [[ -f $RUN/pid ]] && kill -0 "$(cat "$RUN/pid")" 2>/dev/null; then echo "the Sparks are serving: stop first"; exit 1; fi
  link
  echo "all-reduce between this Spark and $PEER (the first run builds the RDMA extension on both)"
  both_ranks profiling.tp_comm --tp-address "$ADDR" "$@" 2>&1 | grep -v '^\[rank 1\]' 
}

case "${1:-}" in
  serve) shift; cmd_serve "$@" ;;
  _run) shift; cmd_run "$@" ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) shift; tail -n 50 "$@" "$RUN/serve.log" ;;
  setup) cmd_setup ;;
  comm) shift; cmd_comm "$@" ;;
  draft-head) link; both_ranks profiling.tp_draft_head --tp-address "$ADDR" 2>&1 | grep -v '^\[rank 1\]' ;;
  *) sed -n '2,15p' "$0"; exit 2 ;;
esac
